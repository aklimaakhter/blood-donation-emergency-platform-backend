model Review {
  id        String   @id @default(uuid())
  userId    String
  donorId   String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  donor     Donor    @relation(fields: [donorId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reviews")
}
