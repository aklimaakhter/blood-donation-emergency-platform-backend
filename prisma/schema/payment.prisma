model Payment {
  id                    String        @id @default(uuid())
  status                PaymentStatus @default(PENDING)
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("BDT")
  paymentGateway        String        @default("bkash")
  merchantInvoiceNumber String        @unique
  bkashPaymentId        String?       @unique
  bkashTrxId            String?
  payerReference        String?
  paidAt                String?

  gatewayResponse       Json?
  
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)

 bloodRequestId        String?       @unique
  bloodRequest          BloodRequest? @relation(fields: [bloodRequestId], references: [id], onDelete: Cascade)

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("payments")
}